# ============================================================
# Pi³ — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Server IP (the IP of the Database/GUI Pi - Rpi4) ---
# On Rpi4 itself, leave as localhost
# On all other Pis, set to Rpi4's LAN IP (e.g. 192.168.1.100)
PI_SERVER_IP=localhost
PI_SERVER_PORT=8000

# --- Node Identity (uncomment the line for YOUR Pi) ---
# Rpi1 (Scanner):
# NODE_ID=rpi1-scanner
# NODE_TYPE=scanner

# Rpi2 (Solver):
# NODE_ID=rpi2-solver
# NODE_TYPE=solver

# Rpi3 (Motor):
# NODE_ID=rpi3-motors
# NODE_TYPE=motor

# Rpi4 (Database & GUI):
# NODE_ID=rpi4-db
# NODE_TYPE=database

# --- Timing ---
HEARTBEAT_INTERVAL=3

# --- Database (Rpi4 only) ---
DATABASE_URL=./rubiks.db
